# Copy to .env and set a private URL-safe password. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
GENERATION_MODE=template
WORKFLOW_MONTHLY_RUN_LIMIT=40
# For real AI, set GENERATION_MODE=llm and configure these server-side.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=

# Server-side automatic research provider; never put this in NEXT_PUBLIC variables.
BRAVE_SEARCH_API_KEY=

# Social accounts: server-only credentials; see docs/SOCIAL_ACCOUNTS.md
SOCIAL_TOKEN_ENCRYPTION_KEY=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/v1/social/instagram/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/v1/social/facebook/callback
META_GRAPH_VERSION=v25.0

# LinkedIn: Client ID/secret, OpenID Connect product enabled.
LINKEDIN_APP_ID=
LINKEDIN_APP_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/v1/social/linkedin/callback
# TikTok: APP_ID means the TikTok Client Key. Register an approved HTTPS callback.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=
