# Export these in your shell or use uvicorn --env-file .env.
DATABASE_URL=sqlite:///./founderos.db
FRONTEND_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
GENERATION_MODE=template
# To use real AI: GENERATION_MODE=llm and set these server-side.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=your-provider-model
# LLM_API_KEY=configure-in-secret-manager
# Optional operator-only publishing connector. Obtain a scoped OAuth token
# through your own LinkedIn developer app; never put it in the frontend.
# LINKEDIN_CONNECTOR_JSON={"organization_id":"your-org-id","channel":"linkedin","author":"urn:li:person:your-author-id","access_token":"scoped-oauth-token","api_version":"202610"}
